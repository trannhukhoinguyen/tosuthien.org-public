const heroes = defineCollection({
  loader: glob({ pattern: "**!/[^_]*.{md,mdx}", base: `./${HERO_PATH}` }),
  schema: ({ image }) =>
    z.object({
      title: z.string(),
      description: z.string(),
      draft: z.boolean().optional(),
      cover: image().optional(),
      tags: z.array(z.string()).default([]),
    }),
