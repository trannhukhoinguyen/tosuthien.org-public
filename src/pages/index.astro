---
import Layout from '@/layouts/Layout.astro';
import PostTags from "@/components/post/PostTags.astro";
import PostImage from "@/components/post/PostImage.astro";
import { CONTENT_MAP } from "@/utils/getMarkdownContent.ts";
import { toKebabCase } from "@/utils/helper.ts";
import Hero from "@/components/ui/Hero.astro";
import BioWithImage from "@/components/ui/BioWithImage.astro";
import HtmlBlocks from "@/components/ui/HtmlBlocks.astro";
import HTTDL from "@/components/htmlData/HTTDL.astro";
import LANKA_SUTRA_IMPORTANCE from "../components/htmlData/LANKA_SUTRA_IMPORTANCE.astro";
import InstallPWA from "@/components/ui/InstallPWA.astro";
import PWAPopup from "@/components/ui/PWAPopup.astro";
import YouTubePlaylist from "@/components/ui/media/YouTubePlaylist.astro";
import SeeAllBtn from '@/components/ui/button/SeeAllBtn.astro';
import WorkBuddy from "~/icons/ai-agent.gif";
// import Calendar from '@/components/ui/calendar/Calendar.astro';
// import StorySliderList from '@/components/ui/story/StorySliderList.astro';
// import stories from '@/data/stories/all-stories.ts';

import {
  AI_ENHANCED_YTB_VIDS,
  YTB_VIDS,
  FAQ_YTB_VIDS,
} from "../data/videos/khai_thi_phap_mon_to_su_thien.ts";
import {
  VIDEO_SCIENCE_VIDS,
} from "@/data/videos/video_khoa_hoc.ts";
import rules from '@/data/notices/rules.ts';
import principles from '@/data/notices/principles.ts';
import { l } from "@/utils/constants.ts";

const maxQuantity = 6;
const tagLine0 = "Chẳng cùng muôn pháp làm bạn là người gì?";
const tagLine1 = "Khi chưa có trời đất, ta là cái gì?";
const tagLine2 = "Muôn pháp về một, một về chỗ nào?";
const tagLine3 = "Trước khi cha mẹ chưa sanh, mặt mũi bổn lai của ta ra sao?";
const tagLine4 = "Sanh từ đâu đến, chết đi về đâu?";
const tagLine5 = "Chẳng phải tâm, chẳng phải Phật, chẳng phải vật, là cái gì?";

const blogPosts = CONTENT_MAP['blogs'].posts
  ?.slice(0, maxQuantity)
  ?.map(post => {
    const { frontmatter } = post as any;

    return {
      title: frontmatter?.title,
      frontmatter,
      slug: '/blogs/' + toKebabCase(frontmatter?.title),
    }
});
const practicePosts = CONTENT_MAP['practices'].posts
  ?.filter(post => post.frontmatter.showInHomepage)
  ?.map(post => {
    const { frontmatter } = post as any;

    return {
      title: frontmatter?.title,
      frontmatter,
      slug: '/practices/' + toKebabCase(frontmatter?.title),
    }
});

const title = "Trang chủ";
const description = "Xem " + title;

// Lấy param [lang] từ URL động của Astro (mặc định là 'vi' nếu không khớp)
const { lang = 'vi' } = Astro.params;
---

<Layout
    title={title}
    description={description}
    showSidebar={false}
>
  <div class="landing-page">

    <!-- Hero Section -->
    <Hero
      title={l("home.heroTitle", lang)}
      subtitle="Tham Thoại Đầu - Khởi Nghi Tình"
      description="Kiến tánh thành Phật"
      actions={[
        {
          href: "https://tosuthien.net/",
          text: "Hỏi & Đáp với AI",
          className: "btn-image ai-robot-btn question-mark",
          target: "_blank",
          isShowModal: true,
          imgUrl: WorkBuddy.src,
        },
        {
          href: "/faqs",
          text: "Hỏi & Đáp",
          subText: "Hỏi & Đáp với HT. Thích Duy Lực",
          className: "btn-primary question-mark",
        },
        {
          href: "/practices",
          text: "Thực Hành",
        },
        {
          href: "#rules",
          text: "Chú ý",
          subText: "Chú ý & Tâm niệm khi thực hành",
          className: "btn-primary",
        },
      ]}
    />

    <!-- Image Section -->
    <section class="image-area">
      <PostImage imageUrl={'/images/backgrounds/Buddha-zen.avif'} imageAlt={'Thiền định của Phật - Tổ Sư Thiền'} />
      <p class="tag-line-accent">{tagLine0}</p>
    </section>

<!-- Image Section -->
    <section class="image-area">
      <PostImage imageUrl={'/images/books/covers/Thang-Man-phu-nhan-phat-nguyen.jpg'} imageAlt={'Thiền định của Phật - Tổ Sư Thiền'} />
      <p class="tag-line-accent">{tagLine5}</p>
    </section>

    <hr class="blog-rule" />

    <!-- BioWithImage Section -->
    <BioWithImage
      src= "/images/masters/Weili-Juekai.jpg"
      alt= "HT. THÍCH DUY LỰC"
      href= "/masters/Weili-Juekai"
      playlist= "https://youtube.com/playlist?list=PLA7qBSMZgp0xALxzJB0K4Eg9-RBLtMr68"
    >
      <HTTDL />
    </BioWithImage>

    <hr class="blog-rule" />

    <h2>KHAI THỊ CỦA HT. THÍCH DUY LỰC</h2>
    <p class="tag-line-accent mt-6">{tagLine5}</p>
    <div>
      <!-- ✅ Youtube Video Playlist, Audio -->
      <YouTubePlaylist videos={[
          ...AI_ENHANCED_YTB_VIDS,
          ...YTB_VIDS,
          ...FAQ_YTB_VIDS,
      ]} />
    </div>

    <hr class="blog-rule" />

    <!-- HtmlBlocks Section -->
    <HtmlBlocks>
      <LANKA_SUTRA_IMPORTANCE />
    </HtmlBlocks>

    <hr class="blog-rule" />

    <h2>VIDEO KHOA HỌC GIẢI THÍCH VỀ THẾ GIỚI DUY THỨC</h2>
    <div>
      <!-- ✅ Youtube Video Playlist, Audio -->
      <YouTubePlaylist videos={[
        ...VIDEO_SCIENCE_VIDS,
      ]} />
    </div>

    <hr class="blog-rule" />

    <!-- Hero Section -->
    <InstallPWA />
    <PWAPopup />

    <!-- Rule Section -->
    <section class="rules" id="rules">
      <div class="container">
        <h2 class="section-title">10 Chú Ý</h2>
        <p class="tag-line-accent">{tagLine4}</p>
        <p class="blog-description">Người tham Tổ Sư Thiền phải chú ý những điều sau đây</p>

        <div class="accordion-group">
          {
            rules?.map((rule, index) => (
              <details class="accordion-item">
                <summary class="accordion-header">
                  <span class="badge">{index + 1}</span>
                  <h3 class="rule-title">{rule.title}</h3>
                  <span class="chevron-icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion-body">
                  <p class="rule-description">{rule.description}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Principle Section -->
    <section class="typography-showcase">
      <div class="container">
        <h2 class="section-title">2 Tâm Niệm</h2>
        <p class="tag-line-accent">{tagLine2}</p>
        <p class="typography-description">
          Muốn đạt đến kiến tánh giải thoát, hành giả tham tổ sư thiền cần phải thực hành đúng theo cơ bản như sau
        </p>

        <div class="accordion-group">
          {
            principles?.map((principle, index) => (
              <details class="accordion-item" open={index === 0}>
                <summary class="accordion-header">
                  <h4 class="sample-h1">{principle.title}</h4>
                  <span class="chevron-icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion-body">
                  <div class="type-meta">
                    {
                      principle.description?.includes(' / ')
                        ? principle.description?.split(' / ')?.map(line => <p>{line}</p>)
                        : <p>{principle.description}</p>
                    }
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Practice Section -->
    <section class="blog-section" id="practices">
      <div class="container">
        <h2 class="section-title">Thực Hành</h2>
        <p class="tag-line-accent">{tagLine1}</p>

        {practicePosts.length > 0 && (
          <div class="accordion-group">
            {practicePosts.map(post => (
              <details class="accordion-item">
                <summary class="accordion-header">
                  <h3 class="blog-post-title">{post.title}</h3>
                  <span class="chevron-icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion-body">
                  <div class="post-content">
                    <PostTags frontmatter={post.frontmatter} />
                    <a href={post.slug} class="read-more-btn">Xem chi tiết &rarr;</a>
                  </div>
                </div>
              </details>
            ))}
          </div>
        )}

        <SeeAllBtn collection="practices" />
      </div>
    </section>

    <!-- Blog Section -->
    <section class="blog-section" id="blogs">
      <div class="container">
        <h2 class="section-title">Bài viết</h2>
        <p class="tag-line-accent">{tagLine3}</p>

        {blogPosts.length > 0 && (
          <div class="accordion-group">
            {blogPosts.map(post => (
              <details class="accordion-item">
                <summary class="accordion-header">
                  <h3 class="blog-post-title">{post.frontmatter.title}</h3>
                  <span class="chevron-icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion-body">
                  <div class="post-content">
                    <PostTags frontmatter={post.frontmatter} />
                    <a href={post.slug} class="read-more-btn">Xem chi tiết &rarr;</a>
                  </div>
                </div>
              </details>
            ))}
          </div>
        )}

        <SeeAllBtn />
      </div>
    </section>

    <!-- STORY -->
<!--    <section class="typography-showcase">
      <div class="container">
        <StorySliderList
          stories={stories}
          title="Chuyện Kể Thấu Cảm & Từ Bi"
          subtitle="Nhấp vào từng câu chuyện để xem bộ tranh minh họa tự động chạy slider"
        />
      </div>
    </section>-->

    <!-- CALENDAR -->
<!--    <section class="typography-showcase">
      <div class="container">
        <h2 class="section-title">Lịch Sự Kiện</h2>

        <div class="typography-samples">
          <Calendar />
        </div>
      </div>
    </section>-->

  </div>
</Layout>

<style>
  .landing-page {
    width: 100%;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .image-area {
    text-align: center;
    padding: calc(var(--grid-unit) * 1) 0 calc(var(--grid-unit) * 1);
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
  }

  .hero {
    text-align: center;
    padding: calc(var(--grid-unit) * 1) 0 calc(var(--grid-unit) * 1);
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .hero-title {
    font-family: var(--font-heading-primary),serif;
    font-size: 4.5rem;
    font-weight: 700;
    color: var(--color-accent-goldenrod);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 1.3;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .hero-subtitle {
    font-family: var(--font-heading-secondary),serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .hero-description {
    font-size: 1.375rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: calc(var(--grid-unit) * 4);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-rule {
    height: 6px;
    background-color: var(--color-accent-goldenrod);
    border: none;
    width: 150px;
    margin: 0 auto calc(var(--grid-unit) * 4);
  }

  .hero-actions {
    display: flex;
    gap: calc(var(--grid-unit) * 2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--font-heading-secondary),serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
    border-radius: 4px;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    font-size: 0.95rem;
  }

  .btn-primary {
    background-color: var(--color-accent-goldenrod);
    color: white;
    border: 2px solid var(--color-accent-goldenrod);
  }

  .btn-primary:hover,
  .btn-primary:focus {
    background-color: transparent;
    color: var(--color-accent-gold);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover,
  .btn-secondary:focus {
    background-color: var(--color-text-primary);
    color: var(--color-background);
    transform: translateY(-2px);
  }

  /* Dark mode button styles */
  :global([data-theme="dark"]) .btn-primary {
    background-color: var(--color-accent-goldenrod);
    color: white;
    border-color: var(--color-accent-goldenrod);
  }

  :global([data-theme="dark"]) .btn-primary:hover,
  :global([data-theme="dark"]) .btn-primary:focus {
    background-color: transparent;
    color: var(--color-accent-gold);
  }

  :global([data-theme="dark"]) .btn-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  :global([data-theme="dark"]) .btn-secondary:hover,
  :global([data-theme="dark"]) .btn-secondary:focus {
    background-color: var(--color-accent-gold);
    color: white;
    border-color: var(--color-accent-gold);
  }

  .rules {
    padding: calc(var(--grid-unit) * 8) 0;
  }

  .section-title {
    font-family: var(--font-heading-secondary),serif;
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-accent-goldenrod);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: calc(var(--grid-unit) * 6);
    text-align: center;
  }

  .rules-grid {
    display: grid;
    /*grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));*/
    gap: calc(var(--grid-unit) * 4);
    grid-template-columns: 1fr;
  }

  .rule-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: calc(var(--grid-unit) * 4);
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .rule-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-gold);
  }

  .rule-icon {
    font-size: 3rem;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .rule-title {
    font-family: var(--font-heading-secondary),serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent-goldenrod);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: calc(var(--grid-unit) * 1.5);
  }

  .rule-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Typography Showcase */
  .typography-showcase {
    padding: calc(var(--grid-unit) * 4) 0;
    background-color: var(--color-surface);
  }

  .typography-description {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .typography-samples {
    display: grid;
    gap: calc(var(--grid-unit) * 6);
  }

  .type-sample {
    text-align: center;
    padding: calc(var(--grid-unit) * 4);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .sample-h1 {
    font-family: var(--font-heading-primary),serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-accent-goldenrod);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 1.1;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .sample-h2 {
    font-family: var(--font-heading-secondary),serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent-goldenrod);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.2;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .sample-body {
    font-family: var(--font-body),serif;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: calc(var(--grid-unit) * 2);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .sample-code {
    font-family: var(--font-mono),serif;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: calc(var(--grid-unit)) calc(var(--grid-unit) * 1.5);
    border-radius: 4px;
    display: inline-block;
    margin-bottom: calc(var(--grid-unit) * 2);
    color: var(--color-text-primary);
  }

  .type-meta {
    font-family: var(--font-mono),serif;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .blog-section {
    max-width: 100%;
    padding: calc(var(--grid-unit) * 4) 0;
  }

  .blog-description {
    text-align: center;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 6);
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-posts {
    display: grid;
    /*grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));*/
    gap: calc(var(--grid-unit) * 4);
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .blog-post-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: calc(var(--grid-unit) * 2);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .blog-post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent-goldenrod);
  }

  .blog-post-title {
    font-family: var(--font-heading-secondary),serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: calc(var(--grid-unit));
  }

  .blog-post-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .blog-post-title a:hover,
  .blog-post-title a:focus {
    color: var(--color-accent-gold);
  }

  .blog-post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(var(--grid-unit));
    margin-bottom: calc(var(--grid-unit) * 1.5);
  }

  .blog-post-date {
    font-family: var(--font-mono),serif;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-post-reading-time {
    font-family: var(--font-mono),serif;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-post-reading-time::before {
    content: "•";
    margin: 0 calc(var(--grid-unit) / 2);
    color: var(--color-border);
  }

  .blog-post-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .blog-post-badges {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid-unit) / 2);
  }

  .blog-badge {
    background-color: var(--color-text-primary);
    color: white;
    padding: calc(var(--grid-unit) / 4) calc(var(--grid-unit) / 2);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  /* Dark mode blog badge styles */
  :global([data-theme="dark"]) .blog-badge {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .blog-actions {
    text-align: center;
  }

  .installation {
    padding: calc(var(--grid-unit) * 8) 0;
    background-color: var(--color-surface);
  }

  .install-steps {
    display: grid;
    gap: calc(var(--grid-unit) * 4);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: calc(var(--grid-unit) * 2);
    align-items: start;
  }

  .step-number {
    font-family: var(--font-heading-primary),serif;
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-accent-goldenrod);
    margin: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-family: var(--font-heading-secondary),serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: calc(var(--grid-unit));
  }

  .code-block {
    display: flex;
    width: 100%;
    background-color: var(--color-text-primary);
    color: var(--color-background);
    padding: calc(var(--grid-unit) * 2);
    border-radius: 8px;
    overflow-x: auto;
    margin: 0;
  }

  .code-block code {
    width: 100%;
    font-family: var(--font-mono),serif;
    background: none;
    border: none;
    color: inherit;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .hero-description {
