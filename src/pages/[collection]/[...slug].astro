---
import "@/styles/post/post.css";
import "@/styles/badge/badgeList.css";
import "@/styles/additional/Comment.css"; // nếu bạn tách CSS ra file riêng
import { CONTENT_MAP } from "@/utils/getMarkdownContent.ts";
import Layout from "@/layouts/Layout.astro";
import TOC from "@/components/post/TOC.astro";
import FloatingTOC from "@/components/post/FloatingTOC.astro";

import MediaArea from "@/components/ui/media/MediaArea.astro";
import YoutubeLayout from "@/components/ui/media/YoutubeLayout.astro";

import Breadcrumb from "@/components/ui/breadcrumbs/Breadcrumb.astro";
import PostHeader from "@/components/post/PostHeader.astro";
import PostTags from "@/components/post/PostTags.astro";
import ItemReadAll from "@/components/post/ItemReadAll.astro";
import PostImage from "@/components/post/PostImage.astro";
import RelatedPostList from "@/components/postList/RelatedPostList.astro";

export async function getStaticPaths() {
  return Object.entries(CONTENT_MAP).flatMap(([collection, data]) =>
      data.posts.map((post: any) => {
        return {
          params: {
            collection,
            slug: post.file.split("/").pop()?.replace(/\.(md|mdx)$/, ""),
          },
          props: { post, collection },
        };
      })
  );
}

const { slug } = Astro.params;
const { post, collection } = Astro.props;
const { frontmatter, Content } = post as any;
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    type="article"
    publishedTime={frontmatter.date ? new Date(frontmatter.date).toISOString() : undefined}
    collection={collection}
>
  <!-- ✅ Breadcrumb -->
  <Breadcrumb collection={collection} title={frontmatter.title} />

  {
    <article class="blog-post">
          <!-- ✅ PostHeader included PDF Viewer -->
          <PostHeader post={post} />

          <!-- Image Section -->
          {
            post.frontmatter.image
              ?  <section class="image-area">
                    <PostImage imageUrl={post.frontmatter.image} imageAlt={post.frontmatter.title} />
                 </section>
              :  ""
          }

          <!-- ✅ TOC -->
          <TOC post={post} />
          <FloatingTOC post={post} />

          <div class="post-content">
            <!-- ✅ Content -->
            <Content />
          </div>

          <div>
            <!-- ✅ Youtube Video Playlist, Audio -->
            <MediaArea frontmatter={frontmatter} />
          </div>

          <div>
            <!-- ✅ Youtube Videos -->
            <YoutubeLayout frontmatter={frontmatter} />
          </div>
        </article>
  }

  <footer class="post-footer">
    <!-- ✅ Tags -->
    <PostTags frontmatter={frontmatter} />

    <ItemReadAll collection={collection} />
  </footer>

<!-- Related Post List Section -->
  <RelatedPostList tags={frontmatter.tags} notIncludedPostTitle={frontmatter.title} type={frontmatter.type} />
</Layout>

<style>
  .blog-rule {
    height: 2px;
    background-color: var(--color-accent-gold);
    border: none;
    width: 100%;
    margin: 0 auto;
  }
</style>
