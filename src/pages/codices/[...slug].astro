---
import "@/styles/wiki-type/slug.wiki.css"
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/wiki-type/CodexLayout.astro";
import { getCodexSlug, getCodexUrl } from "@/utils/codices.ts";

export async function getStaticPaths() {
    const codices = await getCollection("codices");
    return codices.map((entry) => ({
        params: { slug: getCodexSlug(entry) },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"codices">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allDocs = await getCollection("codices");

const wordCount = entry.body
    ? entry.body.trim().split(/\s+/).filter(Boolean).length
    : 0;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const codicesForNavigation = allDocs
    .filter((codex) =>
        entry.data.category ? codex.data.category === entry.data.category : true,
    )
    .map((codex, indexDoc) => ({
      ...codex,
      order: indexDoc,
    }))
    .sort((a, b) => {
        const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
        const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
        if (orderA !== orderB) return orderA - orderB;
        return a.data.title.localeCompare(b.data.title);
    });

const entrySlug = getCodexSlug(entry);

const currentIndex = codicesForNavigation.findIndex((codex) => getCodexSlug(codex) === entrySlug);
const previousDoc = currentIndex > 0 ? codicesForNavigation[currentIndex - 1] : undefined;
const nextDoc =
    currentIndex >= 0 && currentIndex < codicesForNavigation.length - 1
        ? codicesForNavigation[currentIndex + 1]
        : undefined;

const relatedSameCategory = allDocs
    .filter(
        (codex) =>
            getCodexSlug(codex) !== entrySlug &&
            (entry.data.category ? codex.data.category === entry.data.category : false),
    )
    .sort((a, b) => {
        const updatedA = a.data.lastUpdated?.getTime() ?? 0;
        const updatedB = b.data.lastUpdated?.getTime() ?? 0;
        return updatedB - updatedA;
    });

const relatedFallback = allDocs
    .filter(
        (codex) =>
            getCodexSlug(codex) !== entrySlug &&
            !relatedSameCategory.some((sameDoc) => getCodexSlug(sameDoc) === getCodexSlug(codex)),
    )
    .sort((a, b) => {
        const updatedA = a.data.lastUpdated?.getTime() ?? 0;
        const updatedB = b.data.lastUpdated?.getTime() ?? 0;
        return updatedB - updatedA;
    });

const relatedArticles = [...relatedSameCategory, ...relatedFallback]
  .filter((e) => getCodexSlug(e) !== entrySlug)
  .filter((e) => e.data.category === entry.data.category)
  .slice(0, 5)
  .map((codex) => ({
      title: codex.data.title,
      description:
          codex.data.description || `Tìm hiểu thêm về ${codex.data.title} trong hướng dẫn này.`,
      href: getCodexUrl(codex),
  }));
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    category={entry.data.category}
    currentSlug={entrySlug}
    headings={headings}
    articleData={{
        publishedTime: entry.data.publishedDate?.toISOString(),
        modifiedTime: entry.data.lastUpdated?.toISOString(),
        author: "Sưu tầm",
        tags: entry.data.tags,
        readTimeMinutes,
    }}
    navigationData={{
        previous: previousDoc
            ? { title: previousDoc.data.title, href: getCodexUrl(previousDoc) }
            : undefined,
        next: nextDoc
            ? { title: nextDoc.data.title, href: getCodexUrl(nextDoc) }
            : undefined,
    }}
    relatedArticles={relatedArticles}
>
    <Content />
</Layout>
