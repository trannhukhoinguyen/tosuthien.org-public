---
import "@/styles/wiki-type/slug.wiki.css"
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/wiki-type/KoanLayout.astro";
import { getKoanSlug, getKoanUrl } from "@/utils/koan.ts";

export async function getStaticPaths() {
  const koans = await getCollection("koans");
  return koans.map((entry) => ({
    params: { slug: getKoanSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"koans">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allKoans = await getCollection("koans");

const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

// Logic tính toán navigation, related articles... (giữ nguyên như cũ)
const koansForNavigation = allKoans
  .filter((enlightener) => entry.data.category ? enlightener.data.category === entry.data.category : true)
  .map((enlightener, indexKoan) => ({ ...enlightener, order: indexKoan }))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.data.title.localeCompare(b.data.title));

const entrySlug = getKoanSlug(entry);
const currentIndex = koansForNavigation.findIndex((e) => getKoanSlug(e) === entrySlug);
const previousKoan = currentIndex > 0 ? koansForNavigation[currentIndex - 1] : undefined;
const nextKoan = currentIndex >= 0 && currentIndex < koansForNavigation.length - 1 ? koansForNavigation[currentIndex + 1] : undefined;

const relatedArticles = allKoans
  .filter((e) => getKoanSlug(e) !== entrySlug)
  .filter((e) => e.data.category === entry.data.category)
  .slice(0, 5)
  .map((e) => ({
    title: e.data.title,
    description: e.data.description || `Tìm hiểu thêm về ${e.data.title}`,
    href: getKoanUrl(e),
  }));

// Kiểm tra nội dung bài viết có thực sự chứa các tab con này không
const hasIntro = entry.body?.includes('class="tab-intro"') || false;
const hasComment = entry.body?.includes('class="tab-comment"') || false;
const hasPoetry = entry.body?.includes('class="tab-poetry"') || false;
const hasComment2 = entry.body?.includes('class="tab-comment2"') || false;

// Nếu YAML chưa khai báo tabLabels nhưng bài viết có import nội dung Dialogue/Sermon, ta tự động thêm vào
let tabLabels = [...(entry.data.tabLabels || [])];

if (tabLabels.length === 0) {
  if (hasIntro) tabLabels.push("intro");
  if (hasComment) tabLabels.push("comment");
  if (hasPoetry) tabLabels.push("poetry");
  if (hasComment2) tabLabels.push("comment2");
} else {
  // Nếu có khai báo, ta lọc lại để chắc chắn chỉ hiện tab nào thực sự có div tồn tại trong bài
  tabLabels = tabLabels.filter(label => {
    const slug = label.toLowerCase().trim();
    if (slug === 'intro') return hasIntro;
    if (slug === 'comment') return hasComment;
    if (slug === 'poetry') return hasPoetry;
    if (slug === 'comment2') return hasComment2;
    return true; // Các tab khác như mantra, story giữ nguyên
  });
}
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  currentSlug={entrySlug}
  headings={headings}
  articleData={{
    publishedTime: entry.data.publishedDate?.toISOString(),
    modifiedTime: entry.data.lastUpdated?.toISOString(),
    extraKoanScrolls: entry.data.extraKoanScrolls,
    tags: entry.data.tags,
    readTimeMinutes,
  }}
  navigationData={{
    previous: previousKoan ? { title: previousKoan.data.title, href: getKoanUrl(previousKoan) } : undefined,
    next: nextKoan ? { title: nextKoan.data.title, href: getKoanUrl(nextKoan) } : undefined,
  }}
  relatedArticles={relatedArticles}
  tabLabels={tabLabels}
  videoIds={entry.data.videoIds}
  activeTab="main"
>
  <Content />
</Layout>
