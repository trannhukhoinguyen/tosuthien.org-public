---
import "@/styles/wiki-type/slug.wiki.css"
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/wiki-type/CompendiumLayout.astro";
import { getCompendiumSlug, getCompendiumUrl } from "@/utils/compendia.ts";

export async function getStaticPaths() {
    const compendia = await getCollection("compendia");
    return compendia.map((entry) => ({
        params: { slug: getCompendiumSlug(entry) },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"compendia">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allDocs = await getCollection("compendia");

const wordCount = entry.body
    ? entry.body.trim().split(/\s+/).filter(Boolean).length
    : 0;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const compendiaForNavigation = allDocs
    .filter((compendium) =>
        entry.data.category ? compendium.data.category === entry.data.category : true,
    )
    .map((compendium, indexDoc) => ({
      ...compendium,
      order: indexDoc,
    }))
    .sort((a, b) => {
        const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
        const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
        if (orderA !== orderB) return orderA - orderB;
        return a.data.title.localeCompare(b.data.title);
    });

const entrySlug = getCompendiumSlug(entry);

const currentIndex = compendiaForNavigation.findIndex((compendium) => getCompendiumSlug(compendium) === entrySlug);
const previousDoc = currentIndex > 0 ? compendiaForNavigation[currentIndex - 1] : undefined;
const nextDoc =
    currentIndex >= 0 && currentIndex < compendiaForNavigation.length - 1
        ? compendiaForNavigation[currentIndex + 1]
        : undefined;

const relatedSameCategory = allDocs
    .filter(
        (compendium) =>
            getCompendiumSlug(compendium) !== entrySlug &&
            (entry.data.category ? compendium.data.category === entry.data.category : false),
    )
    .sort((a, b) => {
        const updatedA = a.data.lastUpdated?.getTime() ?? 0;
        const updatedB = b.data.lastUpdated?.getTime() ?? 0;
        return updatedB - updatedA;
    });

const relatedFallback = allDocs
    .filter(
        (compendium) =>
            getCompendiumSlug(compendium) !== entrySlug &&
            !relatedSameCategory.some((sameDoc) => getCompendiumSlug(sameDoc) === getCompendiumSlug(compendium)),
    )
    .sort((a, b) => {
        const updatedA = a.data.lastUpdated?.getTime() ?? 0;
        const updatedB = b.data.lastUpdated?.getTime() ?? 0;
        return updatedB - updatedA;
    });

const relatedArticles = [...relatedSameCategory, ...relatedFallback]
  .filter((e) => getCompendiumSlug(e) !== entrySlug)
  .filter((e) => e.data.category === entry.data.category)
  .slice(0, 5)
  .map((compendium) => ({
      title: compendium.data.title,
      description:
          compendium.data.description || `Tìm hiểu thêm về ${compendium.data.title} trong hướng dẫn này.`,
      href: getCompendiumUrl(compendium),
  }));

const tabLabels = [{
  icon: '🇻🇳',
  label: 'Tiếng Việt',
},{
  icon: '📝',
  label: 'Âm Hán Việt',
},{
  icon: '🇨🇳',
  label: 'Tiếng Trung',
},];
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    category={entry.data.category}
    currentSlug={entrySlug}
    headings={headings}
    articleData={{
        publishedTime: entry.data.publishedDate?.toISOString(),
        modifiedTime: entry.data.lastUpdated?.toISOString(),
        author: "Sưu tầm",
        tags: entry.data.tags,
        readTimeMinutes,
    }}
    navigationData={{
        previous: previousDoc
            ? { title: previousDoc.data.title, href: getCompendiumUrl(previousDoc) }
            : undefined,
        next: nextDoc
            ? { title: nextDoc.data.title, href: getCompendiumUrl(nextDoc) }
            : undefined,
    }}
    relatedArticles={relatedArticles}
    tabLabels={tabLabels}
>
    <Content />
</Layout>
