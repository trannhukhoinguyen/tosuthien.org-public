---
import { getCollection } from "astro:content";
import Layout from "@/layouts/wiki-type/Layout.astro";
import Search from "../../../components/wiki-type/compendium/SearchCompendium.astro";
import { getCompendiumUrl } from "@/utils/compendia.ts";
import { getTimeAgo } from "@/utils/dateUtils";

export async function getStaticPaths() {
    const allCompendia = await getCollection("compendia");
    const categoryOrder = [
      "compendium",
      "Chưa phân loại",
    ];
    const categories = [
        ...new Set(allCompendia.map((compendium) => compendium.data.category || "Chưa phân loại")),
    ].sort((a, b) => {
        const ai = categoryOrder.indexOf(a);
        const bi = categoryOrder.indexOf(b);
        const an = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
        const bn = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;
        if (an === bn) return a.localeCompare(b);
        return an - bn;
    });
    const categoryCounts = categories.reduce(
        (acc, cat) => {
            acc[cat] = allCompendia.filter(
                (compendium) => (compendium.data.category || "Chưa phân loại") === cat,
            ).length;
            return acc;
        },
        {} as Record<string, number>,
    );

    return categories.map((category) => {
        const slug = category?.toLowerCase().replace(/\s+/g, "-");
        const categoryDocs = allCompendia.filter(
            (compendium) => (compendium.data.category || "Chưa phân loại") === category,
        );
        return {
            params: { category: slug },
            props: {
                category,
                compendia: categoryDocs,
                allCompendia,
                allCategories: categories,
                categoryCounts,
            },
        };
    });
}

const { category, compendia: compendiaToDisplay, allCompendia, allCategories, categoryCounts } = Astro.props;

// Sort compendia by date or title
const sortedDocs = compendiaToDisplay.sort((a, b) =>
    b.data.title.localeCompare(a.data.title),
);

// Get other categories for the sidebar
const categoriesWithCounts = allCategories.map((cat) => {
    return {
        name: cat,
        slug: cat.toLowerCase().replace(/\s+/g, "-"),
        count: categoryCounts?.[cat] || 0,
    };
});
---

<Layout title={`${category} - Tổ Sư Thiền`}>
  <header class="page-header">
    <div class="page-header__overlay"></div>
    <div class="container-wide page-header__container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
          </li>
          <li class="breadcrumb__item">
            <span class="breadcrumb__separator">/</span>
            <a href="/compendia" class="breadcrumb__link">Tóm tắt</a>
          </li>
          <li class="breadcrumb__item">
            <span class="breadcrumb__separator">/</span>
            <span class="breadcrumb__current">{category}</span>
          </li>
        </ol>
      </nav>

      <h1 class="page-header__title">{category}</h1>
      <p class="page-header__desc">
        {`Khám phá các hướng dẫn và bài viết chi tiết về ${category}.`}
      </p>
      <div class="page-header__meta">{compendiaToDisplay.length} bài viết</div>

      <div class="page-header__search">
        <Search />
      </div>
    </div>
  </header>

  <div class="content-section">
    <div class="container-wide">
      <div class="content-layout">
        <!-- Sidebar:  -->
        <aside class="sidebar">
          <div class="sidebar-card">
            <h4 class="sidebar-card__title">Các danh mục liên quan</h4>
            <nav class="category-nav">
              {categoriesWithCounts.map((cat) => (
                <a
                  href={`/compendia/category/${cat.slug}`}
                  class:list={[
                    "category-nav__item",
                    cat.name === category && "category-nav__item--active"
                  ]}
                >
                  <span class="category-nav__main">
                    <span class="category-nav__dot"></span>
                    <span class="category-nav__text">{cat.name}</span>
                  </span>
                  <span class="category-nav__badge">{cat.count}</span>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- Article List -->
        <main
          class="article-main"
          x-data={`{
            currentPage: 1,
            perPage: 10,
            totalItems: ${sortedDocs.length},
            get totalPages() { return Math.max(1, Math.ceil(this.totalItems / this.perPage)); },
            get startIndex() { return (this.currentPage - 1) * this.perPage + 1; },
            get endIndex() { return Math.min(this.currentPage * this.perPage, this.totalItems); },
            goToPage(page) { this.currentPage = Math.min(Math.max(page, 1), this.totalPages); },
            isVisible(index) {
              const start = (this.currentPage - 1) * this.perPage;
              const end = this.currentPage * this.perPage;
              return index >= start && index < end;
            }
          }`}
        >
          <div class="article-header">
            <h3 class="article-header__title">Bài viết</h3>
            <span
              class="article-header__count"
              x-text="`Hiển thị ${startIndex}-${endIndex} của ${totalItems} bài viết`"
            ></span>
          </div>

          <div class="article-list">
            {sortedDocs.map((compendium, index) => (
              <article
                x-show={`isVisible(${index})`}
                class="article-card"
              >
                <div class="article-card__header">
                  <h4 class="article-card__title">
                    <a href={getCompendiumUrl(compendium)} class="article-card__link">
                      {compendium.data.title}
                    </a>
                  </h4>
                  <span class="article-card__date">
                    {compendium.data.lastUpdated && getTimeAgo(compendium.data.lastUpdated)}
                  </span>
                </div>
                <p class="article-card__desc">
                  {compendium.data.description || "Tìm hiểu thêm về chủ đề này trong tài liệu chi tiết của chúng tôi. Chúng tôi cung cấp các hướng dẫn từng bước cùng ví dụ minh họa để giúp bạn thành công."}
                </p>
                <a href={getCompendiumUrl(compendium)} class="article-card__cta">
                  Đọc bài viết
                  <span class="article-card__cta-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </a>
              </article>
            ))}
          </div>

          <!-- Simple Pagination -->
          <div class="pagination" x-show="totalPages > 1">
            <button
              type="button"
              @click="goToPage(currentPage - 1)"
              :disabled="currentPage === 1"
              class="pagination__btn"
              aria-label="Previous page"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>

            <template x-for="page in totalPages" :key="page">
              <button
                type="button"
                @click="goToPage(page)"
                :class="currentPage === page ? 'pagination__page--active' : 'pagination__page--inactive'"
                class="pagination__btn pagination__page"
                x-text="page"
              ></button>
            </template>

            <button
              type="button"
              @click="goToPage(currentPage + 1)"
              :disabled="currentPage === totalPages"
              class="pagination__btn"
              aria-label="Next page"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12H19M19 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
          </div>
        </main>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ==========================================================================
     CSS Variables & Tokens
     ========================================================================== */
  :root {
    /* Dynamic Fallbacks */
    --sgkb-primary: #3b82f6;
    --sgkb-primary-light: #60a5fa;
    --sgkb-overlay-soft: rgba(255, 255, 255, 0.15);
    --sgkb-surface-subtle: #f1f5f9;
    --sgkb-border-soft-muted: #e2e8f0;
    --sgkb-shadow-xs-soft: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --sgkb-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);

    /* Brand Colors */
    --brand-gray-50: #f8fafc;
    --brand-gray-100: #f1f5f9;
    --brand-gray-200: #e2e8f0;
    --brand-gray-400: #94a3b8;
    --brand-gray-500: #64748b;
    --brand-gray-600: #475569;
    --brand-gray-900: #0f172a;

    /* Transitions */
    --transition-smooth: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ==========================================================================
     Layout Base Components
     ========================================================================== */
  .container-wide {
    width: 100%;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* ==========================================================================
     Header Section
     ========================================================================== */
  .page-header {
    position: relative;
    overflow: visible;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    background: linear-gradient(90deg, var(--sgkb-primary) 0%, var(--sgkb-primary-light) 100%);
  }

  @media (min-width: 1024px) {
    .page-header {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  .page-header__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 15% 0%, var(--sgkb-overlay-soft), transparent 55%);
  }

  .page-header__container {
    position: relative;
    z-index: 10;
  }

  /* Breadcrumb Navigation */
  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.5rem;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    column-gap: 1rem;
  }

  .breadcrumb__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: #ffffff;
  }

  .breadcrumb__separator {
    color: rgba(255, 255, 255, 0.45);
  }

  .breadcrumb__current {
    color: #ffffff;
    font-weight: 600;
  }

  /* Page Header Content */
  .page-header__title {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .page-header__desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
    max-width: 72rem; /* 6xl */
    margin-top: 0;
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .page-header__desc {
      font-size: 18px;
    }
  }

  .page-header__meta {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 2.25rem;
  }

  .page-header__search {
    max-width: 480px;
  }

  .page-header__search > div {
    margin-left: 0;
    margin-right: 0;
  }

  /* ==========================================================================
     Main Content Layout
     ========================================================================== */
  .content-section {
    padding-top: 6rem;
    padding-bottom: 6rem;
    background-color: var(--brand-gray-50);
  }

  .content-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .content-layout {
      flex-direction: row;
    }
  }

  /* ==========================================================================
     Sidebar: Categories
     ========================================================================== */
  .sidebar {
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .sidebar {
      width: 20rem; /* 80 = 320px */
    }
  }

  .sidebar-card {
    background-color: #ffffff;
    border-radius: 18px;
    padding: 1.75rem;
    border: 1px solid var(--brand-gray-200);
    box-shadow: var(--sgkb-shadow-xs-soft);
    position: sticky;
    top: 6rem;
  }

  .sidebar-card__title {
    font-size: 20px;
    font-weight: 600;
    color: var(--brand-gray-900);
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .category-nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .category-nav__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: var(--brand-gray-600);
    transition: var(--transition-smooth);
  }

  .category-nav__item:hover {
    color: var(--sgkb-primary);
    background-color: var(--sgkb-surface-subtle);
  }

  .category-nav__item--active {
    color: var(--sgkb-primary);
    background-color: var(--sgkb-surface-subtle);
  }

  .category-nav__main {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .category-nav__dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: var(--sgkb-primary);
    flex-shrink: 0;
  }

  .category-nav__text {
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .category-nav__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    border-radius: 10px;
    background-color: var(--brand-gray-100);
    color: var(--brand-gray-400);
    font-size: 12px;
    font-weight: 600;
  }

  /* ==========================================================================
     Article List Section
     ========================================================================== */
  .article-main {
    flex-grow: 1;
    min-width: 0;
  }

  .article-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--brand-gray-200);
  }

  .article-header__title {
    font-size: 2.25rem; /* text-4xl */
    font-weight: 700;
    color: var(--brand-gray-900);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .article-header__count {
    font-size: 14px;
    font-weight: 400;
    color: var(--brand-gray-400);
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Article Card */
  .article-card {
    background-color: #ffffff;
    border-radius: 18px;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--sgkb-border-soft-muted);
    transition: var(--transition-smooth);
  }

  .article-card:hover {
    border-color: var(--sgkb-primary-light);
    box-shadow: var(--sgkb-shadow-md);
    transform: translateY(-2px);
  }

  .article-card__header {
    margin-bottom: 0.75rem;
  }

  .article-card__title {
    font-size: 20px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--brand-gray-900);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .article-card__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-card__link:hover {
    color: var(--sgkb-primary);
  }

  .article-card__date {
    font-size: 14px;
    font-weight: 400;
    color: var(--brand-gray-400);
  }

  .article-card__desc {
    color: var(--brand-gray-500);
    font-size: 15px;
    line-height: 1.65;
    margin-top: 0;
    margin-bottom: 1.25rem;

    /* CSS line-clamp (giới hạn 2 dòng) */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 14px;
    font-weight: 600;
    color: var(--sgkb-primary);
    text-decoration: none;
  }

  .article-card__cta-icon {
    display: inline-flex;
    transition: transform 0.2s ease;
  }

  .article-card__cta:hover .article-card__cta-icon {
    transform: translateX(2px);
  }

  /* ==========================================================================
     Pagination Controls
     ========================================================================== */
  .pagination {
    margin-top: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pagination__btn {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background-color: #ffffff;
    border: 1px solid var(--brand-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-gray-400);
    transition: var(--transition-smooth);
    cursor: pointer;
  }

  .pagination__btn:hover:not(:disabled) {
    border-color: var(--sgkb-primary);
    color: var(--sgkb-primary);
  }

  .pagination__btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pagination__page {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pagination__page--active {
    background-color: var(--sgkb-primary);
    border-color: var(--sgkb-primary);
    color: #ffffff;
  }

  .pagination__page--inactive {
    background-color: #ffffff;
    border-color: var(--brand-gray-200);
    color: var(--brand-gray-500);
  }

  .pagination__page--inactive:hover {
    border-color: var(--sgkb-primary);
    color: var(--sgkb-primary);
  }
</style>

<style>
  // TABLE
  /* Định hình bảng và xử lý tràn chữ */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    table-layout: auto;
  }

  /* Tạo khoảng cách chữ và đường viền */
  th, td {
    border: 1px solid #cbd5e1;
    padding: 10px 14px;
    text-align: left;
    word-break: break-word;
  }

  /* Tạo kiểu cho hàng tiêu đề */
  th {
    background-color: #f1f5f9;
    font-weight: 600;
  }

  /* Xe kẽ màu giữa các hàng */
  tr:nth-child(even) {
    background-color: #f8fafc;
  }
</style>
