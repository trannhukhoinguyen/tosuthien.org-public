---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../config.ts';

interface Props {
    title: string;
    description?: string;
    showSidebar?: boolean;
    image?: string;
    type?: 'website' | 'article';
    publishedTime?: string;
    modifiedTime?: string;
    canonical?: string;
    collection?: string;

    // 🔥 schema type
    schemaType?:
        | 'Article'
        | 'WebPage'
        | 'Person'
        | 'Place'
        | 'FAQPage'
        | 'Book'
        | 'CreativeWork'
        | 'VideoObject';

    // 👤 Person
    person?: {
        name?: string;
        description?: string;
        birthDate?: string;
        deathDate?: string;
        master?: string;
        disciples?: string[];
    };

    // 📍 Place
    place?: {
        name?: string;
        description?: string;
    };

    // 📚 Book
    book?: {
        author?: string;
        translator?: string;
    };

    // ❓ FAQ
    faqs?: {
        question: string;
        answer: string;
    }[];

    // ❓ KOAN
    koan?: {
        master?: string;
        disciple?: string;
        lineage?: string;
    };

    // 🎬 VIDEO
    video?: {
        name?: string;
        description?: string;
        uploadDate?: string;
        thumbnailUrl?: string;
        embedUrl?: string;
        contentUrl?: string;
        duration?: string; // ISO 8601 (PT5M30S)
    };

    // 📂 PDF
    pdf?: {
        name?: string;
        url?: string;
    };
}

const {
    title,
    description,
    image = '/images/backgrounds/Buddha-zen.avif',
    publishedTime,
    modifiedTime,
    canonical,
    collection = null,
    schemaType = 'Article'
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE_URL || Astro.site).toString();
const imageURL = new URL(image, SITE_URL || Astro.site).toString();
const metaDescription = description || SITE_DESCRIPTION;

//
// 🌐 WEBSITE
//
const websiteSchema = {
    "@type": "WebSite",
    "@id": `${SITE_URL}#website`,
    "url": SITE_URL,
    "name": SITE_TITLE,
    "description": SITE_DESCRIPTION,
    "publisher": {
        "@id": `${SITE_URL}#organization`
    }
};

//
// 🏢 ORGANIZATION
//
const orgSchema = {
    "@type": "Organization",
    "@id": `${SITE_URL}#organization`,
    "name": SITE_TITLE,
    "url": SITE_URL,
    "logo": {
        "@type": "ImageObject",
        "url": new URL('/favicon-new.ico', SITE_URL).toString()
    }
};

//
// 🔥 CONTENT SCHEMA (CORE)
//
const contentSchema = (() => {

    // 👤 PERSON
    if (schemaType === 'Person') {
        return {
            "@type": "Person",
            "@id": `${canonicalURL}#person`,
            "name": Astro.props.person?.name || title,
            "description": metaDescription,
            "url": canonicalURL,

            // 🔥 định danh riêng
            "additionalType": "https://tosuthien.org/schema/ZenMaster",

            ...(Astro.props.person?.birthDate && {
                "birthDate": Astro.props.person.birthDate
            }),

            ...(Astro.props.person?.deathDate && {
                "deathDate": Astro.props.person.deathDate
            }),

            // 🔥 truyền thừa
            ...(Astro.props.person?.master && {
                "mentor": {
                    "@type": "Person",
                    "name": Astro.props.person.master
                }
            }),

            ...(Astro.props.person?.disciples && {
                "knows": Astro.props.person.disciples.map(name => ({
                    "@type": "Person",
                    "name": name
                }))
            }),

            "knowsAbout": ["Thiền tông", "Công án", "Zen Buddhism"],


        };
    }

    // 📍 PLACE
    if (schemaType === 'Place') {
        return {
            "@type": "Place",
            "@id": `${canonicalURL}#place`,
            "name": Astro.props.place?.name || title,
            "description": metaDescription,
            "url": canonicalURL,


        };
    }

    // 📚 BOOK
    if (schemaType === 'Book') {
        return {
            "@type": "Book",
            "@id": `${canonicalURL}#book`,
            "name": title,
            "description": metaDescription,
            ...(Astro.props.book?.author && {
                "author": {
                    "@type": "Person",
                    "name": Astro.props.book.author
                }
            }),
            ...(Astro.props.book?.translator && {
                "translator": {
                    "@type": "Person",
                    "name": Astro.props.book.translator
                }
            }),
            "url": canonicalURL,

            // 🔥 định danh riêng
            "additionalType": "https://tosuthien.org/schema/BuddhistText",


        };
    }

    // ❓ FAQ
    if (schemaType === 'FAQPage') {
        return {
            "@type": "FAQPage",
            "@id": `${canonicalURL}#faq`,
            "mainEntity": (Astro.props.faqs || []).map(faq => ({
                "@type": "Question",
                "name": faq.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": faq.answer
                }
            })),

            // 🔥 định danh riêng
            "additionalType": "https://tosuthien.org/schema/BuddhistText",


        };
    }

    // 🧘 CREATIVE WORK
    if (schemaType === 'CreativeWork') {
        return {
            "@type": "CreativeWork",
            "@id": `${canonicalURL}#koan`,
            "name": title,
            "description": metaDescription,
            "url": canonicalURL,

            // 🔥 định danh riêng
            "additionalType": "https://tosuthien.org/schema/ZenKoan",

            // 🔥 Thiền sư tạo công án
            ...(Astro.props.koan?.master && {
                "author": {
                    "@type": "Person",
                    "name": Astro.props.koan.master
                }
            }),

            // 🔥 người hỏi / người bị hỏi
            ...(Astro.props.koan?.disciple && {
                "recipient": {
                    "@type": "Person",
                    "name": Astro.props.koan.disciple
                }
            }),

            // 🔥 dòng thiền
            ...(Astro.props.koan?.lineage && {
                "isPartOf": {
                    "@type": "Organization",
                    "name": Astro.props.koan.lineage
                }
            }),

            // 🔥 keyword cực mạnh
            "genre": "Zen Koan",
            "keywords": ["công án", "thiền tông", "zen koan"],


        };
    }

    // 📰 ARTICLE (fallback)
    if (schemaType === 'Article') {
        return {
            "@type": "Article",
            "@id": `${canonicalURL}#article`,
            "headline": title,
            "description": metaDescription,
            "image": [imageURL],
            "datePublished": publishedTime,
            ...(modifiedTime && { dateModified: modifiedTime }),
            "author": {
                "@type": "Organization",
                "@id": `${SITE_URL}#organization`
            },
            "publisher": {
                "@id": `${SITE_URL}#organization`
            },
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": canonicalURL
            },

            // 🔥 định danh riêng
            "additionalType": "https://tosuthien.org/schema/BuddhistText",


        };
    }

    // 🎬 VIDEO
    if (schemaType === 'VideoObject') {
        return {
            "@type": "VideoObject",
            "@id": `${canonicalURL}#video`,
            "hasPart": [{ "@id": `${canonicalURL}#video` }, { "@id": `${canonicalURL}#pdf` }],
            "name": Astro.props.video?.name || title,
            "description": Astro.props.video?.description || metaDescription,
            "thumbnailUrl": [
                Astro.props.video?.thumbnailUrl || imageURL
            ],
            ...(Astro.props.video?.uploadDate && {
                "uploadDate": Astro.props.video.uploadDate
            }),
            ...(Astro.props.video?.duration && {
                "duration": Astro.props.video.duration
            }),
            ...(Astro.props.video?.embedUrl && {
                "embedUrl": Astro.props.video.embedUrl
            }),
            ...(Astro.props.video?.contentUrl && {
                "contentUrl": Astro.props.video.contentUrl
            }),
            "publisher": {
                "@id": `${SITE_URL}#organization`
            },
            "additionalType": "https://tosuthien.org/schema/ZenTalk",


        };
    }

    // 🌐 DEFAULT
    return {
        "@type": "WebPage",
        "@id": canonicalURL,
        "name": title,
        "description": metaDescription,
        "isPartOf": {
            "@id": `${SITE_URL}#website`
        }
    };

})();

//
// 🍞 BREADCRUMB
//
const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": SITE_URL
        },
        ...(collection ? [{
            "@type": "ListItem",
            "position": 2,
            "name": collection,
            "item": `${SITE_URL}/${collection.toLowerCase()}`
        }] : []),
        {
            "@type": "ListItem",
            "position": collection ? 3 : 2,
            "name": title,
            "item": canonicalURL
        }
    ]
};

//
// 🎬 VIDEO
//
const videoSchema = Astro.props.video && {
  "@type": "VideoObject",
  "@id": `${canonicalURL}#video`,
  "name": Astro.props.video.name || title,
  "thumbnailUrl": [Astro.props.video.thumbnailUrl || imageURL],
  ...(Astro.props.video.uploadDate && {
      "uploadDate": Astro.props.video.uploadDate
  }),
  ...(Astro.props.video.duration && {
      "duration": Astro.props.video.duration
  }),
  ...(Astro.props.video.embedUrl && {
      "embedUrl": Astro.props.video.embedUrl
  }),
  "publisher": {
      "@id": `${SITE_URL}#organization`
  },
  "isPartOf": {
    "@id": contentSchema["@id"]
  },

  // 🔥 ontology
  "additionalType": "https://tosuthien.org/schema/ZenTalk",


};

//
// 🎬 GALLERY
//
// Build Schema.org ImageGallery Structured Data
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, Astro.url.origin).toString(),
};

//
// 📂 PDF
//
const pdfSchema = Astro.props.pdf && {
  "@type": "MediaObject",
  "@id": `${canonicalURL}#pdf`,
  "name": Astro.props.pdf.name || title,
  "contentUrl": Astro.props.pdf.url,
  "encodingFormat": "application/pdf",
  "isPartOf": {
    "@id": contentSchema["@id"]
  }
};

//
// 🔥 FINAL GRAPH
//
// Gom tất cả vào một biến schemaData
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    websiteSchema,
    orgSchema,
    contentSchema,
    breadcrumbSchema,
    ...(videoSchema ? [videoSchema] : []),
    ...(pdfSchema ? [pdfSchema] : []),
    ...(gallerySchema ? [gallerySchema] : [])
  ]
};
---

<!-- Render trực tiếp ra HTML -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
