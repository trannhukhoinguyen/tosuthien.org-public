---
import '@fontsource/oswald/300.css';
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/roboto-condensed/300.css';
import '@fontsource/roboto-condensed/400.css';
import '@fontsource/roboto-condensed/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '@/styles/global.css';

import Header from '@/components/page/Header.astro';
import Sidebar from '@/components/page/Sidebar.astro';
import Footer from '@/components/page/Footer.astro';
import SEO from '@/components/page/SEO.astro';
import schema from '@/data/schema.astro';

import BackToTop from '@/components/ui/button/BackToTop.astro';
import SkipToBottom from "@/components/ui/button/SkipToBottom.astro";
import HuaTouModalWithAudios from "@/components/ui/modal/HuaTouModalWithAudios.astro";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '@/config.ts';

import { ClientRouter } from 'astro:transitions';
import ZenLoader from '@/components/ui/loading/ZenLoader.astro';
import SearchPagefind from "@/components/ui/search/SearchModal.astro";

export interface Props {
  title: string;
  description?: string;
  showSidebar?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  collection?: string;

  // 🔥 schema type
  schemaType?:
      | 'Article'
      | 'WebPage'
      | 'Person'
      | 'Place'
      | 'FAQPage'
      | 'Book'
      | 'CreativeWork'
      | 'VideoObject';
}

const {
  title,
  description,
  showSidebar = true,
  image = '/images/backgrounds/Buddha-zen.jpg',
  type,
  publishedTime,
  modifiedTime,
  canonical,
  collection = null,
  schemaType = 'Article'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon-new.ico" sizes="48x48" type="image/x-icon">

    <!--PWA manifest-->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d4af37" />
    <script> if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/pwa-sw.js') } </script>

    <script is:inline src="/theme-init.js"></script>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      canonical={canonical}
    />

    <ClientRouter />
  </head>
  <body>

    <div id="top"></div>

    <div class="site-wrapper">
    <Header />


    <HuaTouModalWithAudios />

    <main class="main-content" class:list={{ 'with-sidebar': showSidebar }} data-pagefind-body>
      <div class="content">
        <slot />

        <!--<SearchPagefind />-->
      </div>

      {showSidebar && (
        <aside class="sidebar">
        <Sidebar collection={collection} />
      </aside>
      )}
    </main>

      <BackToTop />
      <SkipToBottom />
      <Footer />
      </div>

    <div id="bottom"></div>

    <ZenLoader />
  </body>
</html>

<style>
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
    width: 100%;
  }

  .main-content.with-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--grid-unit) * 4);
  }

  .content {
    min-width: 0;
    padding: calc(var(--grid-unit) * 2) 0;
  }

  .sidebar {
    order: 2;
    padding-top: calc(var(--grid-unit) * 3);
  }

/* Desktop: 2 cột */
  @media (min-width: 1024px) {
    .main-content.with-sidebar {
      grid-template-columns: 3fr 1fr;
    }

    .sidebar {
      order: 2;
      padding-top: calc(var(--grid-unit) * 1);
    }
  }


    .skip-link {
    background: var(--color-background-accent);
    left: 0;
    right: 0;
    margin: auto;
    width: min-content;
      white-space: nowrap;
    padding: 0.5rem;
    position: absolute;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
      z-index: 100;
  }

    .skip-link:focus {
    transform: translateY(0%);
  }
</style>
