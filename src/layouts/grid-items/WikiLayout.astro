---
import Layout from "./Layout.astro";
import SidebarBook from "@/components/grid-items/SidebarBook.astro";
import SearchModalBook from "@/components/grid-items/SearchModalBook.astro";
import SearchChapter from "@/components/grid-items/SearchChapter.astro";
import SearchModalChapter2 from "@/components/grid-items/SearchModalChapter2.astro";
import YoutubeLayout from "@/components/ui/media/YoutubeLayout.astro";
import YouTubePlaylist from "@/components/ui/media/YouTubePlaylist.astro";
import { l } from "@/utils/grid-items/labels.ts";
import ThemeSwitcher from "@/components/ui/button/ThemeSwitcher.astro";

interface Props {
  title: string;
  currentSlug?: string;
  bookSlug?: string;
  poemSlug?: string;
  videoIds?: any;
}

const {
  title,
  currentSlug,
  bookSlug,
  videoIds = null,
} = Astro.props;

// Lấy param [lang] từ URL động của Astro (mặc định là 'vi' nếu không khớp)
const { lang = 'vi' } = Astro.params;
---

<Layout title={title}>
  <div class="wiki">
    <header class="topbar">
      <div class="topbar-left">
        <a href="/" class="home-link" title="Về Trang chủ">{l("nav.goHome", lang)}</a>
        <button id="menu-toggle" class="menu-btn" aria-label="Toggle menu">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <line x1="3" y1="5" x2="15" y2="5" />
            <line x1="3" y1="9" x2="15" y2="9" />
            <line x1="3" y1="13" x2="15" y2="13" />
          </svg>
        </button>
      </div>

      {
        bookSlug && !title?.includes('🔖') && <button id="search-grid-btn" class="search-grid-btn" aria-label="Search">
          🔍
          <kbd>⌘K</kbd>
        </button>
      }
      {
        bookSlug && title?.includes('🔖') && <button id="search-chapter-grid-btn" class="search-chapter-grid-btn" aria-label="Search">
          🔍
          <kbd>⌘B</kbd>
        </button>
      }

      <ThemeSwitcher />
    </header>

    <div class="body">
      <div class="sidebar-overlay" id="sidebar-overlay"></div>
      <aside class="sidebar" id="sidebar">
        {
          bookSlug && <SidebarBook currentSlug={currentSlug} bookSlug={bookSlug} />
        }
      </aside>
      <main class="content">

        <SearchChapter />

        <slot />

        {
          videoIds &&
          <!-- ✅ Youtube Videos -->
          <YoutubeLayout frontmatter={videoIds} />
        }
        <!--        {
                  videoPlaylists &&
                    &lt;!&ndash; ✅ Youtube Video Playlist, Audio &ndash;&gt;
                    <YouTubePlaylist videos={videoPlaylists} />
                }-->
      </main>
    </div>
  </div>
  {
    bookSlug && !title?.includes('🔖') && <SearchModalBook />
  }
  {
    bookSlug && title?.includes('🔖') && <SearchModalChapter2 />
  }
</Layout>

<script>
  document.getElementById("search-grid-btn")?.addEventListener("click", () => {
    (window as any).__openSearch?.();
  });
  document.getElementById("search-chapter-grid-btn")?.addEventListener("click", () => {
    (window as any).__openSearch?.();
  });

  const menuBtn = document.getElementById("menu-toggle");
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sidebar-overlay");

  function closeSidebar() {
    sidebar?.classList.remove("open");
    overlay?.classList.remove("open");
  }

  menuBtn?.addEventListener("click", () => {
    sidebar?.classList.toggle("open");
    overlay?.classList.toggle("open");
  });

  overlay?.addEventListener("click", closeSidebar);

  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeSidebar);
  });
</script>

<style>
  .wiki {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 3rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.25rem;
  }

  .logo {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .search-grid-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.3rem 0.5rem;
    margin-right: auto;
    margin-left: 1rem;
  }

  .search-grid-btn:hover {
    border-color: var(--text-muted);
  }

  .search-grid-btn kbd {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
    font-size: 0.6rem;
    font-family: inherit;
  }

  .body {
    display: flex;
    flex: 1;
  }

  .sidebar-overlay {
    display: none;
  }

  .sidebar {
    width: 14rem;
    flex-shrink: 0;
    border-right: 1px solid var(--border);
    background: var(--bg-sidebar);
    padding: 1.25rem 0;
    position: sticky;
    top: 3rem;
    height: calc(100vh - 3rem);
    overflow-y: auto;
  }

  .content {
    flex: 1;
    max-width: 56rem;
    padding: 2rem 3rem;
  }

  @media (max-width: 768px) {
    .menu-btn {
      display: flex;
    }

    .sidebar {
      position: fixed;
      top: 3rem;
      left: 0;
      height: calc(100vh - 3rem);
      z-index: 20;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 3rem 0 0 0;
      background: rgba(0, 0, 0, 0.3);
      z-index: 15;
    }

    .sidebar-overlay.open {
      display: block;
    }

    .content {
      padding: 1.5rem 1rem;
    }
  }
</style>
