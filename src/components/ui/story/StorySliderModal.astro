---
// StorySliderModal.astro - Component Con chịu trách nhiệm hiển thị Slider Modal và Auto-play
---

<div id="story-modal" class="story-modal-overlay hidden" aria-hidden="true">
  <div class="story-modal-container">
    <!-- Nút đóng -->
    <button id="modal-close-btn" class="modal-close" aria-label="Đóng">&times;</button>

    <!-- Khung hiển thị Slide -->
    <div class="slider-wrapper">
      <div class="slide-content">
        <img id="slider-img" src="" alt="" class="slider-image" />
        <div class="slide-overlay-info">
          <span id="slide-step" class="slide-step-badge">1 / 4</span>
          <h3 id="slide-title" class="slide-title"></h3>
          <p id="slide-desc" class="slide-desc"></p>
        </div>
      </div>

      <!-- Điều hướng Slide -->
      <button id="prev-slide-btn" class="nav-btn prev-btn" aria-label="Slide trước">&#10094;</button>
      <button id="next-slide-btn" class="nav-btn next-btn" aria-label="Slide tiếp">&#10095;</button>
    </div>

    <!-- Thanh công cụ & Progress Bar -->
    <div class="slider-controls">
      <button id="toggle-autoplay-btn" class="control-btn">
        <span id="autoplay-icon">⏸</span> <span id="autoplay-text">Tạm dừng</span>
      </button>
      <div class="progress-bar-bg">
        <div id="autoplay-progress" class="progress-bar-fill"></div>
      </div>
      <div id="slide-dots" class="slide-dots"></div>
    </div>
  </div>
</div>

<script>
  interface Slide {
    img: string;
    title: string;
    desc: string;
    meaning?: string;
  }

  interface Story {
    id: string;
    title: string;
    description: string;
    thumbnail: string;
    subtitle: string;
    slides: Slide[];
  }

  class StorySliderController {
    private modal: HTMLElement | null = null;
    private imgEl: HTMLImageElement | null = null;
    private titleEl: HTMLElement | null = null;
    private descEl: HTMLElement | null = null;
    private stepEl: HTMLElement | null = null;
    private progressEl: HTMLElement | null = null;
    private dotsContainer: HTMLElement | null = null;
    private autoPlayBtnText: HTMLElement | null = null;
    private autoPlayBtnIcon: HTMLElement | null = null;

    private currentStory: Story | null = null;
    private currentIndex: number = 0;
    private isAutoPlaying: boolean = true;
    private timer: number | null = null;
    private progressInterval: number | null = null;
    private readonly SLIDE_DURATION = 5000; // 5 giây/slide

    constructor() {
      this.initElements();
      this.bindEvents();
    }

    private initElements() {
      this.modal = document.getElementById('story-modal');
      this.imgEl = document.getElementById('slider-img') as HTMLImageElement;
      this.titleEl = document.getElementById('slide-title');
      this.descEl = document.getElementById('slide-desc');
      this.stepEl = document.getElementById('slide-step');
      this.progressEl = document.getElementById('autoplay-progress');
      this.dotsContainer = document.getElementById('slide-dots');
      this.autoPlayBtnText = document.getElementById('autoplay-text');
      this.autoPlayBtnIcon = document.getElementById('autoplay-icon');
    }

    private bindEvents() {
      document.getElementById('modal-close-btn')?.addEventListener('click', () => this.close());
      document.getElementById('prev-slide-btn')?.addEventListener('click', () => this.prev());
      document.getElementById('next-slide-btn')?.addEventListener('click', () => this.next());
      document.getElementById('toggle-autoplay-btn')?.addEventListener('click', () => this.toggleAutoPlay());

      // Lắng nghe sự kiện mở story từ component cha
      window.addEventListener('open-story-modal', ((e: CustomEvent<Story>) => {
        if (e.detail) this.open(e.detail);
      }) as EventListener);

      // Đóng khi ấn ESC
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !this.modal?.classList.contains('hidden')) {
          this.close();
        }
      });
    }

    public open(story: Story) {
      this.currentStory = story;
      this.currentIndex = 0;
      this.isAutoPlaying = true;
      this.renderDots();
      this.updateSlide();
      this.modal?.classList.remove('hidden');
      this.modal?.setAttribute('aria-hidden', 'false');
      this.startAutoPlay();
    }

    public close() {
      this.modal?.classList.add('hidden');
      this.modal?.setAttribute('aria-hidden', 'true');
      this.stopAutoPlay();
    }

    private updateSlide() {
      if (!this.currentStory || !this.currentStory.slides.length) return;
      const slide = this.currentStory.slides[this.currentIndex];

      if (this.imgEl) this.imgEl.src = slide.img;
      if (this.titleEl) this.titleEl.textContent = slide.title;
      if (this.descEl) this.descEl.textContent = slide.meaning || slide.desc;
      if (this.stepEl) {
        this.stepEl.textContent = `${this.currentIndex + 1} / ${this.currentStory.slides.length}`;
      }

      this.updateDots();
      this.resetProgress();
    }

    private renderDots() {
      if (!this.dotsContainer || !this.currentStory) return;
      this.dotsContainer.innerHTML = '';
      this.currentStory.slides.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.className = `dot ${idx === this.currentIndex ? 'active' : ''}`;
        dot.addEventListener('click', () => {
          this.currentIndex = idx;
          this.updateSlide();
          if (this.isAutoPlaying) this.startAutoPlay();
        });
        this.dotsContainer?.appendChild(dot);
      });
    }

    private updateDots() {
      const dots = this.dotsContainer?.querySelectorAll('.dot');
      dots?.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === this.currentIndex);
      });
    }

    private next() {
      if (!this.currentStory) return;
      this.currentIndex = (this.currentIndex + 1) % this.currentStory.slides.length;
      this.updateSlide();
      if (this.isAutoPlaying) this.startAutoPlay();
    }

    private prev() {
      if (!this.currentStory) return;
      this.currentIndex = (this.currentIndex - 1 + this.currentStory.slides.length) % this.currentStory.slides.length;
      this.updateSlide();
      if (this.isAutoPlaying) this.startAutoPlay();
    }

    private toggleAutoPlay() {
      this.isAutoPlaying = !this.isAutoPlaying;
      if (this.isAutoPlaying) {
        if (this.autoPlayBtnText) this.autoPlayBtnText.textContent = 'Tạm dừng';
        if (this.autoPlayBtnIcon) this.autoPlayBtnIcon.textContent = '⏸';
        this.startAutoPlay();
      } else {
        if (this.autoPlayBtnText) this.autoPlayBtnText.textContent = 'Tự động chạy';
        if (this.autoPlayBtnIcon) this.autoPlayBtnIcon.textContent = '▶';
        this.stopAutoPlay();
      }
    }

    private startAutoPlay() {
      this.stopAutoPlay();
      if (!this.isAutoPlaying) return;

      let elapsed = 0;
      const step = 50;

      this.progressInterval = window.setInterval(() => {
        elapsed += step;
        const pct = Math.min((elapsed / this.SLIDE_DURATION) * 100, 100);
        if (this.progressEl) this.progressEl.style.width = `${pct}%`;
      }, step);

      this.timer = window.setTimeout(() => {
        this.next();
      }, this.SLIDE_DURATION);
    }

    private stopAutoPlay() {
      if (this.timer) clearTimeout(this.timer);
      if (this.progressInterval) clearInterval(this.progressInterval);
      this.timer = null;
      this.progressInterval = null;
    }

    private resetProgress() {
      if (this.progressEl) this.progressEl.style.width = '0%';
    }
  }

  // Khởi tạo controller
  document.addEventListener('DOMContentLoaded', () => {
    new StorySliderController();
  });
</script>

<style>
  .story-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(10, 15, 25, 0.92);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    transition: opacity 0.3s ease;
  }

  .story-modal-overlay.hidden {
    display: none;
    opacity: 0;
    pointer-events: none;
  }

  .story-modal-container {
    position: relative;
    width: 100%;
    max-width: 900px;
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    z-index: 10;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    font-size: 28px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .modal-close:hover { background: rgba(239, 68, 68, 0.8); }

  .slider-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #000;
  }

  .slider-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slide-overlay-info {
    position: absolute;
    bottom: 0;
    inset-x: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.95), transparent);
    color: #fff;
  }

  .slide-step-badge {
    display: inline-block;
    padding: 2px 10px;
    background: #e11d48;
    font-size: 12px;
    font-weight: bold;
    border-radius: 12px;
    margin-bottom: 6px;
  }

  .slide-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: #f3f4f6;
  }

  .slide-desc {
    font-size: 0.92rem;
    color: #d1d5db;
    line-height: 1.4;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.4);
    color: white;
    border: none;
    font-size: 20px;
    padding: 12px 16px;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .nav-btn:hover { background: rgba(225, 29, 72, 0.8); }
  .prev-btn { left: 12px; }
  .next-btn { right: 12px; }

  .slider-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    background: #1f2937;
  }

  .control-btn {
    background: #374151;
    color: #fff;
    border: none;
    padding: 6px 12px;
    font-size: 13px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .control-btn:hover { background: #4b5563; }

  .progress-bar-bg {
    flex: 1;
    height: 4px;
    background: #374151;
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: #e11d48;
    transition: width 0.05s linear;
  }

  .slide-dots {
    display: flex;
    gap: 6px;
  }

  :global(.dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6b7280;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s;
  }

  :global(.dot.active) {
    background: #e11d48;
    transform: scale(1.3);
  }
</style>
