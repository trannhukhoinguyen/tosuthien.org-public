---
interface Action {
  href: string;
  text?: string;
  subText?: string;
  className?: string;
  isShowModal?: boolean | false;
  target?: string | "_self" | "_blank";
  imgUrl?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  actions?: Action[];
}

const { title, subtitle, description, actions } = Astro.props;
---

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    <p class="hero-subtitle">{subtitle}</p>
    <p class="hero-description tag-line-accent">{description}</p>
    <hr class="hero-rule" />
    <div class="hero-actions">
      {
        actions
        && actions?.length > 0
        && actions?.map(({ href, text, subText, className= "btn-secondary", isShowModal, target, imgUrl }) =>
          <a href={href} class={`btn ${className}`} @click={isShowModal} target={target} title={subText || text}>
          {imgUrl ? <img src={imgUrl} alt={subText || text} width="50" class="btn-image-icon" /> : text}
        </a>)
      }
    </div>
  </div>
</section>

<style scoped>
    .image-area {
        text-align: center;
        padding: calc(var(--grid-unit) * 1) 0 calc(var(--grid-unit) * 1);
        background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
    }


    .hero {
        text-align: center;
        padding: calc(var(--grid-unit) * 1) 0 calc(var(--grid-unit) * 1);
        background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
    }

    .hero-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 var(--content-padding);
    }

    .hero-title {
        font-family: var(--font-heading-primary),serif;
        font-size: 4.5rem;
        font-weight: 700;
        color: var(--color-accent-goldenrod);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        line-height: 1.3;
        margin-bottom: calc(var(--grid-unit) * 2);
    }

    .hero-subtitle {
        font-family: var(--font-heading-secondary),serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: calc(var(--grid-unit) * 3);
    }

    .hero-description {
        font-size: 1.375rem;
        line-height: 1.6;
        color: var(--color-text-primary);
        margin-bottom: calc(var(--grid-unit) * 4);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-rule {
        height: 6px;
        background-color: var(--color-accent-goldenrod);
        border: none;
        width: 150px;
        margin: 0 auto calc(var(--grid-unit) * 4);
    }

    .hero-actions {
      display: flex;
      gap: calc(var(--grid-unit) * 2);
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;

      a {
        display: flex;
        align-items: center;
        max-width: 200px;
      }
    }

    /* All Buttons */
    .btn {
      font-family: var(--font-heading-secondary),serif;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
      border-radius: 4px;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
      font-size: 0.95rem;
      background-color: transparent;
    }

    /* PRIMARY Buttons */
    .btn-primary {
        background-color: var(--color-accent-goldenrod);
        color: white;
        border: 2px solid var(--color-accent-goldenrod);
    }

    .btn-primary:hover,
    .btn-primary:focus {
      color: var(--color-accent-gold);
      transform: translateY(-2px);
    }

    /* SECONDARY Buttons */
    .btn-secondary {
      color: var(--color-text-primary);
      border: 2px solid var(--color-border);
    }

    .btn-secondary:hover,
    .btn-secondary:focus {
      background-color: var(--color-text-primary);
      color: var(--color-background);
      transform: translateY(-2px);
    }

    /* THIRD Buttons */
    .btn-third {
      color: var(--color-accent-green-darkgreen);
      border: 2px solid var(--color-border);
    }

    .btn-third:hover,
    .btn-third:focus {
      background-color: var(--color-background-pagination);
      color: var(--color-accent-green-darkgreen);
      transform: translateY(-2px);
    }

    /* IMAGE Buttons */
    .btn-image {
      border: none;
      padding: 0;

      .btn-image-icon {
        border: none;
      }
    }

    .ai-robot-btn .btn-image-icon {
      position: relative;          /* Bắt buộc để neo dấu ? vào góc */
      border: 2px dashed var(--color-accent-gold);  /* Viền đứt quãng (dashed) hoặc chấm (dotted) */
      border-radius: 16px;         /* Bo tròn các góc */
      padding: 8px;                /* Khoảng cách từ ảnh ra viền */
      display: inline-block;

      &:hover,
      &:focus {
        background: var(--linear-multi);      /* Màu nền của dấu hỏi */
      }
    }

    /* Tạo dấu ? nhỏ ở góc border */
    .question-mark::after {
      content: "?";
      position: absolute;
      top: -8px;                   /* Đẩy lên mép trên góc */
      right: -8px;                 /* Đẩy sang mép phải góc */
      width: 20px;
      height: 20px;
      background-color: var(--color-background);      /* Màu nền của dấu hỏi */
      color: var(--color-accent-gold);              /* Màu chữ dấu hỏi */
      font-size: 12px;
      font-weight: bold;
      border-radius: 50%;          /* Biến nền thành hình tròn */
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--linear-multi);   /* Viền quanh dấu hỏi cho nổi bật */
    }

    .btn-image:hover,
    .btn-image:focus {
        transform: translateY(-2px);
    }

    /* OTHER Buttons */
    .btn-guideline {
        background-color: transparent;
        color: var(--color-accent-red);
        border: 2px solid var(--color-border);
    }

    .btn-guideline:hover,
    .btn-guideline:focus {
        background-color: var(--color-background-pagination);
        color: var(--color-accent-red);
        transform: translateY(-2px);
    }

    /* Dark mode button styles */
    :global([data-theme="dark"]) .btn-primary {
        background-color: var(--color-accent-goldenrod);
        color: white;
        border-color: var(--color-accent-goldenrod);
    }

    :global([data-theme="dark"]) .btn-primary:hover,
    :global([data-theme="dark"]) .btn-primary:focus {
        background-color: transparent;
        color: var(--color-accent-gold);
        border-color: var(--color-accent-gold);
    }

    :global([data-theme="dark"]) .btn-secondary {
        background-color: transparent;
        color: var(--color-text-primary);
        border-color: var(--color-border);
    }

    :global([data-theme="dark"]) .btn-secondary:hover,
    :global([data-theme="dark"]) .--color-accent-goldenrod:focus {
        background-color: var(--color-accent-goldenrod);
        color: white;
        border-color: var(--color-text-primary);
    }
</style>
