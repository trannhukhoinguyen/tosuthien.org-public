<div class="skip-to-bottom-wrapper" title="Xuống cuối trang">
  <div class="skip-to-bottom-container">
    <a href="#bottom" aria-label="skip_to_bottom" class="skip-to-bottom-btn">
      <span class="skip-to-bottom-icon"><span class="skip-to-bottom-arrow">⬇️</span></span>
    </a>
  </div>
</div>

<script>
  document.addEventListener("scroll", () => {
    const btn = document.querySelector(".skip-to-bottom-btn");
    if (!btn) return;

    btn.style.opacity = "1";

    if (window.scrollY > 300) {
      btn.style.opacity = "0";
    }
  });
</script>

