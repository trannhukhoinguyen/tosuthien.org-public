---
// Lấy image từ props để dùng trong component
const { imgSrc = "/images/color-unknown-zen-master.png" } = Astro.props;
---

<div class="zen-universe-container">
  <!-- 1. Mặt trời chiếu sáng nền -->
  <button
    type="button"
    id="sunButton"
    class="sun-glow"
    aria-label="Tu tập thôi"
  ></button>

  <!-- 2. Vị Monk ngồi thiền trôi nổi ở trung tâm -->
  <div class="monk-floating-wrapper">
    <img
      src={imgSrc}
      alt="Monking meditating in space"
      class="monk-image"
    />
  </div>

  <!-- 3. Các bong bóng tâm thức (A Lại Da Thức - Chủng tử) nổi bồng bềnh -->
  <div class="thought-bubble bubble-1">
    <div class="bubble-reflection"></div>
  </div>
  <div class="thought-bubble bubble-2">
    <div class="bubble-reflection"></div>
  </div>
  <div class="thought-bubble bubble-3">
    <div class="bubble-reflection"></div>
  </div>
</div>

<style>
  /* Container tổng thể bối cảnh A Lại Da Thức */
  .zen-universe-container {
    position: relative;
    width: 100%;
    height: 550px;
    background: radial-gradient(circle at center, #71532e 0%, #372512 100%);
    border-radius: 2rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* 1. Hiệu ứng Mặt trời chiếu sáng (Sun Glow) */
  .sun-glow {
    position: absolute;
    top: 20%;
    left: 10%;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(255, 215, 0, 0.9) 0%, rgba(255, 140, 0, 0.4) 40%, transparent 70%);
    border-radius: 50%;
    box-shadow: 0 0 60px 20px rgba(255, 200, 50, 0.6);
    animation: sunPulse 4s ease-in-out infinite;
    z-index: 1;
  }

  /* 2. Vị Monk ngồi thiền & hiệu ứng nổi trôi bồng bềnh */
  .monk-floating-wrapper {
    position: relative;
    z-index: 5;
    animation: monkFloat 5s ease-in-out infinite;
  }

  .monk-image {
    width: 220px;
    height: auto;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.6));
    border: none;
  }

  /* 3. Cấu trúc các Bong bóng tâm thức (Bubbles) nổi bồng bềnh */
  .thought-bubble {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.05) 60%, rgba(255, 215, 0, 0.15) 100%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.2), 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
    z-index: 4;
  }

  /* Hiệu ứng phản chiếu ánh sáng trên bề mặt bong bóng */
  .bubble-reflection {
    position: absolute;
    top: 15%;
    left: 20%;
    width: 25%;
    height: 25%;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    filter: blur(1px);
  }

  /* Định vị và thời gian trôi riêng biệt cho từng bong bóng (tạo sự tự nhiên) */
  .bubble-1 {
    width: 90px;
    height: 90px;
    bottom: 15%;
    left: 10%;
    animation: bubbleFloat1 6s ease-in-out infinite;
  }

  .bubble-2 {
    width: 120px;
    height: 120px;
    top: 10%;
    right: 15%;
    animation: bubbleFloat2 7s ease-in-out infinite;
    animation-delay: 1s;
  }

  .bubble-3 {
    width: 60px;
    height: 60px;
    bottom: 25%;
    right: 25%;
    animation: bubbleFloat3 5s ease-in-out infinite;
    animation-delay: 2s;
  }


  /* KEYFRAMES ANIMATIONS (CSS THUẦN) */

  /* Hiệu ứng bồng bềnh cho Monk (Trục Y kết hợp xoay nhẹ tạo cảm giác thiền định) */
  @keyframes monkFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1deg);
    }
  }

  /* Hiệu ứng nhịp đập ánh sáng mặt trời */
  @keyframes sunPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  /* Các quỹ đạo nổi trôi ngẫu nhiên cho bong bóng tâm thức */
  @keyframes bubbleFloat1 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(10px, -18px) scale(1.05);
    }
  }

  @keyframes bubbleFloat2 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-15px, 15px) scale(0.95);
    }
  }

  @keyframes bubbleFloat3 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(12px, -12px) scale(1.08);
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  // Định nghĩa hàm chuyển trang
  const goToTheSun = () => {
    const targetUrl = "/thu-vien-to-su-thien"; // Thay đường dẫn bạn muốn chuyển tới ở đây

    // Kiểm tra xem dự án có dùng View Transitions hay chuyển trang truyền thống
    if (typeof navigate === "function") {
      navigate(targetUrl);
    } else {
      window.location.href = targetUrl;
    }
  };

  // Gắn sự kiện click cho nút mặt trời
  function setupSunNavigation() {
    const sunBtn = document.getElementById("sunButton");
    if (sunBtn) {
      sunBtn.addEventListener("click", goToTheSun);
    }
  }

  // Chạy lần đầu khi load trang
  setupSunNavigation();

  // Hỗ trợ nếu dự án Astro có bật View Transitions
  document.addEventListener("astro:page-load", setupSunNavigation);
</script>
