---
interface Props {
  title?: string;
  category?: string;
  href?: string;
  date?: string;
  description?: string;
}

const {
  title,
  category,
  href,
  date,
  description = "Tìm hiểu về những điều chưa biết.",
} = Astro.props;
---

<div class="featured-card">
  <div class="featured-card__content">
    <div class="featured-card__badge-wrapper">
      <span class="featured-card__badge">
        Nổi bật
      </span>
      {
        category
        && <span class="featured-card__group-label" title={ category }>📗 { category }</span>
      }
    </div>

    <h4 class="featured-card__title">
      <a href={href} class="featured-card__link">
        {title}
      </a>
    </h4>

    <p class="featured-card__description">
      {description}
    </p>

    <a href={href} class="featured-card__read-more">
      Đọc thêm
      <span class="featured-card__arrow">&rarr;</span>
    </a>
  </div>
</div>

<style>
  /* ==========================================================================
   CSS Variables & Tokens
   ========================================================================== */
  :root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --brand-gray-100: #f3f4f6;
    --brand-gray-500: #6b7280;
    --brand-gray-900: #111827;

    --sgkb-bg-primary: #ffffff;
    --sgkb-bg-secondary: #f9fafb;
    --sgkb-shadow-xs-soft: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    --sgkb-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --sgkb-border-soft-green: #10b981;
    --sgkb-primary: #2563eb;
    --sgkb-primary-light: #60a5fa;
    --sgkb-accent-warning: #f59e0b;
  }

  /* ==========================================================================
     Featured Card Component
     ========================================================================== */
  .featured-card {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 1rem; /* rounded-2xl */
    border: 1px solid var(--brand-gray-100);
    background: linear-gradient(135deg, var(--sgkb-bg-primary) 0%, var(--sgkb-bg-secondary) 100%);
    padding: 1.5rem;
    box-shadow: var(--sgkb-shadow-xs-soft);
    transition: all 0.2s ease;
  }

  /* Hover overlay effect */
  .featured-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--sgkb-primary) 0%, var(--sgkb-primary-light) 100%);
    opacity: 0;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .featured-card:hover {
    border-color: var(--sgkb-border-soft-green);
    transform: translateY(-0.25rem);
    box-shadow: var(--sgkb-shadow-lg);
  }

  .featured-card:hover::before {
    opacity: 0.05;
  }

  .featured-card__content {
    position: relative;
    z-index: 10;
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  /* Badge */
  .featured-card__badge-wrapper {
    margin-bottom: 1rem;
  }

  .featured-card__badge {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 9999px;
    background-color: var(--sgkb-accent-warning);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-card__group {
    color: var(--color-text-primary);
    background-color: var(--color-accent-darkolivegreen);
    font-size: 10px;
    float: right;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 8px;
    border-radius: 9999px;
  }

  .featured-card__group-label {
    position: relative;
    float: right;
    font-size: 12px;
    color: var(--color-accent-goldenrod);
  }


  /* Title */
  .featured-card__title {
    font-size: 20px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--brand-gray-900);
    margin-top: 0;
    margin-bottom: 0.75rem;

    /* Line clamp 3 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-card__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-card__link:hover {
    color: var(--primary);
  }

  /* Description */
  .featured-card__description {
    font-size: 14px;
    color: var(--brand-gray-500);
    line-height: 1.55;
    margin-top: 0;
    margin-bottom: 1.5rem;

    /* Line clamp 3 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Read More Button */
  .featured-card__read-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .featured-card__read-more:hover {
    color: var(--primary-dark);
    transform: translateX(3px);
  }

  .featured-card__arrow {
    transition: transform 0.2s ease;
  }

  .featured-card__read-more:hover .featured-card__arrow {
    transform: translateX(2px);
  }
</style>
