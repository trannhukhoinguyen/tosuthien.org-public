            </ul>
          </li>
        </ul>
      </nav>

      <!-- Mobile controls group - RSS and Search on right -->
      <div class="mobile-controls">
        <ThemeSwitcher />

        <!--<WallpaperPicker />-->
        <SearchMobile />
        <!--<SearchPFMobile />-->

        <!--<LanguageSwitcher />-->
      </div>
    </div>
  </div>
</header>

