{
  "headers": [
    {
      "source": "/favicon-new.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/to-su-thien-la-gi",
      "permanent": true
    },
    {
      "source": "/gioi-thieu",
      "destination": "/to-su-thien-la-gi",
      "permanent": true
    }
  ]
}
